# Frontend-local env template. The AUTHORITATIVE template is the repo-root
# .env.example — this mirrors only the vars the frontend reads. Copy to .env.local.

# Public (exposed to the browser).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only.
API_INTERNAL_URL=http://backend:8080

# Path override for the shared options.json (defaults to ../options.json in dev
# and /app/options.json in docker).
FACTORY_OPTIONS_PATH=

# Auth.js / NextAuth v5.
AUTH_SECRET=change-me-generate-a-32-byte-base64-secret
AUTH_TRUST_HOST=true

# Payload CMS (only needed when Payload is fully wired — see payload.config.ts).
PAYLOAD_SECRET=change-me-generate-a-long-random-secret
DATABASE_URI=postgres://factory:change-me-in-production@postgres:5432/factory
