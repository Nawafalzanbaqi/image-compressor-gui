{
  "name": "@software-factory/frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Software Factory storefront frontend (Phase 1, e-commerce vertical). Config-driven, i18n (ar/en), Next.js 15 App Router.",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "gen:api": "openapi-typescript ../openapi/openapi.yaml -o src/lib/api/generated.ts",
    "postbuild": "next-sitemap --config next-sitemap.config.js"
  },
  "dependencies": {
    "next": "15.5.19",
    "next-auth": "5.0.0-beta.31",
    "next-intl": "3.26.5",
    "server-only": "0.0.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "2.6.0",
    "lucide-react": "0.469.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.2.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "20.17.12",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "@vitejs/plugin-react": "4.3.4",
    "@playwright/test": "1.49.1",
    "autoprefixer": "10.4.20",
    "eslint": "9.18.0",
    "eslint-config-next": "15.5.19",
    "jsdom": "25.0.1",
    "next-sitemap": "4.2.3",
    "openapi-typescript": "7.5.2",
    "postcss": "8.5.1",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vitest": "2.1.8"
  }
}
