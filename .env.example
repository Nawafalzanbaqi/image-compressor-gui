# ─────────────────────────────────────────────────────────────────────────────
# Software Factory — environment template.
# Copy to `.env` and fill in. NEVER commit real secrets. All services read
# configuration from environment variables only (no hardcoded secrets in code).
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=factory
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=factory
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CONNECTION=redis:6379

# ── Backend (.NET 9 API) ─────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
# EF Core connection string (parameterized queries only — no string concat).
ConnectionStrings__Postgres=Host=postgres;Port=5432;Database=factory;Username=factory;Password=change-me-in-production
ConnectionStrings__Redis=redis:6379
# CORS origin allowed to call the API (the frontend).
Cors__AllowedOrigins=http://localhost:3000
# Path to the shared root options.json (mounted into the container).
Factory__OptionsPath=/app/options.json

# ── Frontend (Next.js 15) ────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-side API base (container-to-container).
API_INTERNAL_URL=http://backend:8080

# ── Auth.js / NextAuth v5 (self-hosted, no paid tiers) ───────────────────────
# Generate: `openssl rand -base64 32`
AUTH_SECRET=change-me-generate-a-32-byte-base64-secret
AUTH_TRUST_HOST=true

# ── Payload CMS (embedded in Next.js) ────────────────────────────────────────
PAYLOAD_SECRET=change-me-generate-a-long-random-secret
DATABASE_URI=postgres://factory:change-me-in-production@postgres:5432/factory

# ── Integrations (leave blank to disable; gated by options.json too) ─────────
WHATSAPP_TOKEN=
ZATCA_API_KEY=
# TODO(phase-2): payment provider credentials (tamara, tabi) live here.
TAMARA_API_KEY=
TABI_API_KEY=
